(def bytes [0 1 0xFF -1 \#;])
(test-assert (= (bufget-u8 bytes 2) 255))
(test-assert (= (bufget-u8 bytes 4) 59))
(def values [|1 (long-symbol . other-symbol) "a; b"|])
(test-assert (eq (ix values 1) '(long-symbol . other-symbol)))
(test-assert (eq (ix values 2) "a; b"))
(test-emit bytes values)
'test-ok
